# Cole SOMENTE este location dentro do bloco server existente da VM 1.
# Não substitua o upstream nem o location /balanceamento/ que já funcionam.
#
# As diretivas CORS abaixo também devem ficar dentro do mesmo bloco server,
# fora dos locations. Elas atendem o frontend React executado no host.

proxy_hide_header Access-Control-Allow-Origin;
add_header Access-Control-Allow-Origin "*" always;
add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
add_header Access-Control-Allow-Headers "Accept, Content-Type" always;

if ($request_method = OPTIONS) {
    return 204;
}

location = /biblioteca/todos {
    proxy_pass http://127.0.0.1:3000/agregador/todos;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
}
