# Use NODE-A na VM 1 e NODE-B na VM 2.
NODE_ID=NODE-A
PORT=3000

# Habilite somente na VM 1, onde a rota agregadora deve existir.
AGGREGATOR_ENABLED=true

# URLs usadas apenas pelo backend agregador da VM 1.
LOCAL_NODE_URL=http://127.0.0.1:3000
OTHER_NODE_URL=http://192.168.56.103:3000

# Tempo máximo para aguardar cada nó durante a agregação.
REQUEST_TIMEOUT_MS=3000

# Suficiente para a demonstração em rede Host-Only.
CORS_ORIGIN=*

